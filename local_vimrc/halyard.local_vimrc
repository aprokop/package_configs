source $HOME/.personal/package_configs/local_vimrc/kokkos.local_vimrc
source $HOME/.personal/package_configs/local_vimrc/cabana.local_vimrc
source $HOME/.personal/package_configs/local_vimrc/arborx.local_vimrc

let g:clang_format#command = "/opt/homebrew/opt/llvm@19/bin/clang-format"
let g:clang_format#detect_style_file = 1
let g:clang_format#auto_format = 1
" let g:clang_format#auto_format_git_diff = 0

let g:ctrlp_custom_ignore = { 'dir': 'build*' }

let g:tagbar_ctags_bin = "/opt/homebrew/opt/ctags/bin/ctags"

set shiftwidth=4

syn keyword cType
    \ Edge
    \ Edges
    \ Force
    \ ForceMie
    \ ForceRepulsive
    \ Inputs
    \ Neighbors
    \ Overlap
    \ OverlapRatio
    \ Parametric
    \ PointEdges
    \ PointSurfaces
    \ Points
    \ Position
    \ Radii
    \ RMT
    \ Spacing
    \ Surface
    \ Surfaces
    \ Timer
    \ Unfrozen
